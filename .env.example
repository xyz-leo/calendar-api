GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8088/auth/callback
DATABASE_URL=sqlite:////app/data/calendar.db

# JWT_SECRET and TOKEN_ENCRYPTION_KEY are NOT set here on purpose — the container
# generates both automatically on first boot and persists them in data/.secrets.env.

# Both optional — shown here at their defaults. "<count>/<period>" is parsed by the
# `limits` library (periods: second/minute/hour/day, or a plural like "minutes").
# Applies per client IP. Change either value, then `docker compose restart api` (or
# `up -d` after a rebuild) to pick it up — read once at startup, not hot-reloaded.
# RATE_LIMIT=60/minute
# AUTH_RATE_LIMIT=10/minute
