GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8088/auth/callback
DATABASE_URL=sqlite:////app/data/calendar.db

# JWT_SECRET and TOKEN_ENCRYPTION_KEY are NOT set here on purpose — the container
# generates both automatically on first boot and persists them in data/.secrets.env.
