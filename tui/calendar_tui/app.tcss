Screen {
    background: $background;
}

/* --- SetupScreen --- */

#setup-box {
    width: 64;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 1 3;
}

#setup-banner {
    width: 100%;
    content-align: center middle;
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

#setup-prompt {
    color: $primary;
    margin-bottom: 1;
}

#setup-input {
    border: round $primary;
}

#setup-input:focus {
    border: round $accent;
}

/* --- LoginWaitScreen --- */

#login-wait-box {
    width: 60;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 1 3;
}

#login-wait-label {
    width: 100%;
    content-align: center middle;
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

#login-wait-hint {
    width: 100%;
    content-align: center middle;
    color: $foreground;
}

#login-wait-notice {
    width: 100%;
    content-align: center middle;
    color: $foreground 65%;
    margin-top: 1;
    border-top: solid $panel;
    padding-top: 1;
}

#login-wait-readme-link {
    width: 100%;
    content-align: center middle;
    color: $primary;
    margin-top: 1;
}

/* --- EventListScreen --- */

#events-panel {
    border: round $primary;
    background: $surface;
    margin: 1 2;
    padding: 0 1;
}

#clock {
    width: 100%;
    height: auto;
    padding-top: 1;
}

#clock-time {
    width: 100%;
    content-align: center middle;
    color: $primary;
    text-style: bold;
}

#clock-date {
    width: 100%;
    content-align: center middle;
    color: $foreground;
    margin-top: 1;
}

#events-title {
    width: 100%;
    content-align: center middle;
    color: $accent;
    text-style: bold;
    padding: 1 0 1 0;
}

#events {
    width: 100%;
    height: 1fr;
    max-height: 1000;
    background: $surface;
    scrollbar-color: $primary-darken-3;
    scrollbar-background: $panel;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 0;
}

/* DataTable's own :focus state applies a 5% white background-tint across its
   whole box — including the blank space beyond the last row, which never
   gets that tint applied to the zebra-striped row colors themselves (those
   go through a separate component-style path). On a tall terminal with few
   events, that mismatch reads as a distinct gray "gap" below the list.
   Neutralizing the tint keeps blank space and striped rows the same color. */
#events:focus {
    background-tint: $foreground 0%;
}

#events > .datatable--header {
    background: $panel;
    color: $primary;
    text-style: bold;
}

#events > .datatable--cursor {
    background: $primary 35%;
    color: $foreground;
    text-style: bold;
}

#events > .datatable--even-row {
    background: $surface;
}

#events > .datatable--odd-row {
    background: $panel;
}

#agenda-center {
    height: 1fr;
}

#events-agenda {
    width: 70%;
    min-width: 50;
    max-width: 80;
    height: 100%;
    background: $surface;
    scrollbar-color: $primary-darken-3;
    scrollbar-background: $panel;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 0;
}

/* Day headers (and the blank line before each group) are disabled options —
   OptionList grays those out by default, but here they're headings, not
   unavailable choices, so they get the same treatment as other titles. */
#events-agenda > .option-list--option-disabled {
    color: $accent;
    text-style: bold;
}

/* calendar-tui/ansi-dark/ansi-light all share $accent = gold (see theme.py) —
   fine for titles, but gold-on-near-black reads as "just another yellow" for
   a day header, easy to mistake for a warning. Neon green pulls it apart from
   the rest of the gold accents and reads unambiguously as a date. Scoped to
   these three themes only — neon-purple/neon-yellow and Textual's other
   built-ins keep using $accent as-is. */
.-theme-calendar-tui #events-agenda > .option-list--option-disabled,
.-theme-ansi-dark #events-agenda > .option-list--option-disabled,
.-theme-ansi-light #events-agenda > .option-list--option-disabled {
    color: #39ff14;
}

/* No full-row background block for the current selection — the ">" marker
   swapped into the row's own text (see EventListScreen.on_option_list_
   option_highlighted) is the indicator, with the whole row's text recolored
   to match the "Google Calendar Events" title ($accent) as the other cue. */
#events-agenda > .option-list--option-highlighted {
    background: $surface;
    color: $accent;
    text-style: bold;
}

/* --- EventDetailScreen --- */

EventDetailScreen {
    align: center middle;
}

#detail-box {
    width: 80%;
    min-width: 40;
    max-width: 90;
    height: auto;
    max-height: 80%;
    border: round $primary;
    background: $surface;
    padding: 1 3;
    scrollbar-color: $primary-darken-3;
    scrollbar-background: $panel;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 0;
}

#detail-title {
    width: 100%;
    content-align: center middle;
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

.detail-field {
    width: 100%;
    color: $foreground;
    margin-bottom: 1;
}

/* --- EventFormScreen --- */

EventFormScreen {
    align: center middle;
}

#form-box {
    width: 80%;
    min-width: 50;
    max-width: 90;
    height: auto;
    max-height: 90%;
    border: round $primary;
    background: $surface;
    padding: 1 3;
    scrollbar-color: $primary-darken-3;
    scrollbar-background: $panel;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 0;
}

#form-title {
    width: 100%;
    content-align: center middle;
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

.form-label {
    width: 100%;
    color: $foreground;
    margin-top: 1;
}

#form-box Input {
    border: round $primary;
}

#form-box Input:focus {
    border: round $accent;
}

/* --- ConfirmScreen --- */

#confirm-box {
    width: 64;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 1 3;
}

#confirm-message {
    width: 100%;
    color: $foreground;
    margin-bottom: 1;
}

#confirm-input {
    border: round $primary;
}

#confirm-input:focus {
    border: round $accent;
}

/* --- TimezoneScreen --- */

#timezone-box {
    width: 60;
    height: auto;
    max-height: 30;
    border: round $primary;
    background: $surface;
    padding: 1 3;
}

#timezone-title {
    width: 100%;
    content-align: center middle;
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

#timezone-list {
    height: auto;
    max-height: 20;
    background: $surface;
    scrollbar-color: $primary-darken-3;
    scrollbar-background: $panel;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 0;
}

/* --- ThemesScreen --- */

#themes-box {
    width: 50;
    height: auto;
    max-height: 30;
    border: round $primary;
    background: $surface;
    padding: 1 3;
}

#themes-title {
    width: 100%;
    content-align: center middle;
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

#themes-list {
    height: auto;
    max-height: 20;
    background: $surface;
    scrollbar-color: $primary-darken-3;
    scrollbar-background: $panel;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 0;
}

/* --- OptionsScreen --- */

#options-box {
    width: 50;
    height: auto;
    max-height: 30;
    border: round $primary;
    background: $surface;
    padding: 1 3;
}

#options-title {
    width: 100%;
    content-align: center middle;
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

#options-list {
    height: auto;
    max-height: 20;
    background: $surface;
    scrollbar-color: $primary-darken-3;
    scrollbar-background: $panel;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 0;
}

/* --- AboutScreen --- */

#about-box {
    width: 64;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 1 3;
}

#about-title {
    width: 100%;
    content-align: center middle;
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

#about-text {
    width: 100%;
    color: $foreground;
    margin-bottom: 1;
}

#about-link {
    width: 100%;
    content-align: center middle;
    color: $primary;
}

/* --- FilterScreen --- */

#filter-box {
    width: 50;
    height: auto;
    max-height: 30;
    border: round $primary;
    background: $surface;
    padding: 1 3;
}

#filter-title {
    width: 100%;
    content-align: center middle;
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

#filter-list {
    height: auto;
    max-height: 20;
    background: $surface;
    scrollbar-color: $primary-darken-3;
    scrollbar-background: $panel;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 0;
}

/* --- CalendarScreen --- */

#calendar-box {
    width: 32;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 1 3;
}

#calendar-grid {
    width: 100%;
}

/* --- _FilterPromptScreen --- */

#filter-prompt-box {
    width: 64;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 1 3;
}

#filter-prompt-label {
    width: 100%;
    color: $foreground;
    margin-bottom: 1;
}

#filter-prompt-input {
    border: round $primary;
}

#filter-prompt-input:focus {
    border: round $accent;
}

/* --- ansi-dark / ansi-light: scrollbar color ---
   Textual can't actually darken a color in an ansi=True theme (there's no
   "20% darker" for a fixed terminal palette slot) — $primary-darken-3
   silently resolves to plain $primary there, undoing the point of using it.
   ansi-dark/ansi-light's $primary is the exact same literal hex as
   calendar-tui's (see theme.py), so hardcoding calendar-tui's own resolved
   primary-darken-3 value here keeps the scrollbar identical across both
   instead of reverting to full-brightness ruby. */

.-theme-ansi-dark #events,
.-theme-ansi-dark #events-agenda,
.-theme-ansi-dark #themes-list,
.-theme-ansi-dark #options-list,
.-theme-ansi-dark #detail-box,
.-theme-ansi-dark #form-box,
.-theme-ansi-dark #timezone-list,
.-theme-ansi-dark #filter-list,
.-theme-ansi-light #events,
.-theme-ansi-light #events-agenda,
.-theme-ansi-light #themes-list,
.-theme-ansi-light #options-list,
.-theme-ansi-light #detail-box,
.-theme-ansi-light #form-box,
.-theme-ansi-light #timezone-list,
.-theme-ansi-light #filter-list {
    scrollbar-color: #8b2b41;
}

